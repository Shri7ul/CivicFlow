# CivicFlow frontend — local development environment
# Copy to frontend/.env.local. Only public browser configuration belongs here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and PUBLIC anon key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deployed frontend origin used for Supabase email verification redirects.
# Local dev: http://localhost:3000
# Production: set to the actual deployed Vercel origin (no trailing slash/path),
# and allowlist <origin>/auth/callback in Supabase Auth Redirect URLs.
NEXT_PUBLIC_SITE_URL=
