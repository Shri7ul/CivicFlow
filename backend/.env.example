# CivicFlow API — local development environment
# Copy this file to backend/.env and adjust values as needed.
# Never commit a real .env file or real credentials.

# --- Application ---
APP_NAME=CivicFlow
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Database ---
# Supabase/PostgreSQL. The app normalizes postgres:// and postgresql:// to psycopg.
# Example: postgresql+psycopg://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=30
DATABASE_POOL_RECYCLE_S=1800
DATABASE_CONNECT_TIMEOUT_S=5
# Optional; production defaults to require when the URL has no sslmode.
DATABASE_SSLMODE=

# --- Supabase Auth ---
# Project URL, for example https://your-project.supabase.co
SUPABASE_URL=
# Public browser key (safe to expose to the frontend).
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT settings. Audience is normally "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
# JWKS is the only accepted token verification mechanism.
# Optional override; derived from SUPABASE_URL by default.
SUPABASE_JWKS_URL=
SUPABASE_JWKS_CACHE_SECONDS=3600

# --- Supabase Storage (private incident evidence) ---
# Bucket is created by Alembic migration 0005; keep it private.
SUPABASE_STORAGE_BUCKET=incident-evidence
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300
EVIDENCE_MAX_FILE_SIZE_BYTES=10485760
EVIDENCE_MAX_FILES_PER_UPLOAD=5
