# CivicFlow API — local development environment
# Copy this file to backend/.env and adjust values as needed.
# Never commit a real .env file or real credentials.

# --- Application ---
APP_NAME=CivicFlow
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Database ---
# Supabase/PostgreSQL. The app normalizes postgres:// and postgresql:// to psycopg.
# Example: postgresql+psycopg://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=30
DATABASE_POOL_RECYCLE_S=1800
DATABASE_CONNECT_TIMEOUT_S=5
# Optional; production defaults to require when the URL has no sslmode.
DATABASE_SSLMODE=

# --- Supabase Auth ---
# Project URL, for example https://your-project.supabase.co
SUPABASE_URL=
# Public browser key (safe to expose to the frontend).
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT settings. Audience is normally "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
# JWKS is the only accepted token verification mechanism.
# Optional override; derived from SUPABASE_URL by default.
SUPABASE_JWKS_URL=
SUPABASE_JWKS_CACHE_SECONDS=3600

# --- Supabase Storage (private incident evidence) ---
# Bucket is created by Alembic migration 0005; keep it private.
SUPABASE_STORAGE_BUCKET=incident-evidence
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300
EVIDENCE_MAX_FILE_SIZE_BYTES=10485760
EVIDENCE_MAX_FILES_PER_UPLOAD=5

# Phase 4 incident intelligence thresholds
INTELLIGENCE_DUPLICATE_RADIUS_M=250
INTELLIGENCE_RELATED_RADIUS_M=1500
INTELLIGENCE_DUPLICATE_WINDOW_HOURS=24
INTELLIGENCE_RELATED_WINDOW_HOURS=72
INTELLIGENCE_CANDIDATE_LIMIT=100
INTELLIGENCE_DUPLICATE_TEXT_THRESHOLD=0.30
INTELLIGENCE_DUPLICATE_CONFIDENCE_THRESHOLD=0.55
INTELLIGENCE_RELATED_CONFIDENCE_THRESHOLD=0.42
INTELLIGENCE_INFRASTRUCTURE_RADIUS_M=1000
INTELLIGENCE_IMPACT_DEPTH=2
INTELLIGENCE_IMPACT_LIMIT=20

# Phase 5 urban risk engine
RISK_MODEL_VERSION=risk-v1
RISK_MIN_RESOLUTION=7
RISK_MAX_RESOLUTION=10
RISK_DEFAULT_RESOLUTION=8
RISK_DEFAULT_WINDOW_HOURS=168
RISK_MAX_WINDOW_HOURS=2160
RISK_RECENCY_HALF_LIFE_HOURS=72
RISK_DENSITY_SATURATION=20
RISK_INFRASTRUCTURE_RADIUS_M=750
RISK_MAX_INCIDENTS=20000
RISK_MAX_CELLS=500
RISK_PRIVACY_MIN_INCIDENTS=3
RISK_TREND_MIN_INCIDENTS=3
RISK_WEIGHT_SEVERITY=0.24
RISK_WEIGHT_DENSITY=0.13
RISK_WEIGHT_SPATIAL=0.07
RISK_WEIGHT_RECENCY=0.14
RISK_WEIGHT_ACTIVE=0.08
RISK_WEIGHT_CATEGORY=0.08
RISK_WEIGHT_TREND=0.06
RISK_WEIGHT_INFRASTRUCTURE=0.14
RISK_WEIGHT_DEPENDENCY=0.06
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MODERATE=40
RISK_THRESHOLD_HIGH=65
RISK_THRESHOLD_CRITICAL=85

# Phase 6 decision intelligence (heuristic planning only)
DECISION_MODEL_VERSION=decision-v1
DECISION_MIN_HORIZON_MINUTES=60
DECISION_MAX_HORIZON_MINUTES=10080
DECISION_MAX_ACTIONS=200
DECISION_MAX_RESOURCES=200
DECISION_SOLVER_TIME_LIMIT_MS=1500
DECISION_DEFAULT_RISK_WINDOW_HOURS=168
DECISION_DEFAULT_RESOLUTION=8
# Objective weights must sum to 1.0.
DECISION_WEIGHT_RISK_REDUCTION=0.45
DECISION_WEIGHT_ACTION_COVERAGE=0.25
DECISION_WEIGHT_COST_EFFICIENCY=0.15
DECISION_WEIGHT_TIME_EFFICIENCY=0.15

# Weather-aware incident intelligence (A02 + A06)
# Default provider is Open-Meteo's free non-commercial API: no key required.
# Data is CC BY 4.0; the UI attributes "Open-Meteo.com".
WEATHER_ENABLED=true
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_API_KEY is optional and only needed for a commercial provider.
WEATHER_TIMEOUT_S=8
WEATHER_MAX_RETRIES=2
WEATHER_RETRY_BACKOFF_S=0.5
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_FORECAST_HOURS=12
WEATHER_RULE_HEAVY_RAIN_MM=5
WEATHER_RULE_RAIN_PROBABILITY_PCT=60
WEATHER_RULE_STRONG_WIND_KMH=35
WEATHER_RULE_STRONG_GUST_KMH=50
WEATHER_RULE_HIGH_TEMPERATURE_C=35
